##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script.
#   (2) The Java home directory must be set to the location of
#       your Java installation and be in your PATH,
#
#   Attributes:
#       * JAVA_HOME       - location of a JDK home dir, so /path/to/java/home/bin/java exists
#       * GRADLE_USER_HOME - location of gradle user home dir (default: ~/.gradle)
#       * GRADLE_HOME - (Optional) - If set, points to a Gradle installation directory
#
##############################################################################

set -o nounset
set -o errexit

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

# Try to run Gradle
exec "$SCRIPT_DIR/gradle" "$@"
